# Copy to .env.local and fill in. Never commit a real .env file.

# Shown in the scanner's User-Agent so anyone reading their access logs can find
# out who scanned them and why. Leave unset in development.
SCANNER_CONTACT_URL=https://example.com/scanner

# Where the "book a manual review" call to action points. A mailto: or a booking
# link both work. Falls back to a mailto placeholder when unset.
NEXT_PUBLIC_REVIEW_CONTACT=mailto:hello@example.com

# What the manual review costs, shown on the landing page and at the end of every
# report. Include the currency symbol: the string is printed as given.
NEXT_PUBLIC_REVIEW_PRICE=$180
